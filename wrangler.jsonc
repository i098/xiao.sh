// Cloudflare deploy of the browser product: `bun run deploy:cf` (see README "Cloudflare").
// Account comes from CLOUDFLARE_ACCOUNT_ID in the environment; secrets via `wrangler secret`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiao-sh",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "bun server/bundle.ts" },
  // dist/app.js + favicon, served before the Worker runs; every other path reaches the Worker
  "assets": { "directory": "dist" },
  "workers_dev": true,
  // both hostnames the old tunnel served; www serves the same Worker as the apex
  "routes": [
    { "pattern": "xiao.sh", "custom_domain": true },
    { "pattern": "www.xiao.sh", "custom_domain": true }
  ],
  // .data on Cloudflare: one KV entry per .data-relative file (visits.json, spotify.json, ...)
  "kv_namespaces": [{ "binding": "DATA", "id": "66790071a1af402fbe5045014f12d3ae" }],
  "vars": { "NODE_ENV": "production", "PUBLIC_ORIGIN": "https://xiao.sh" },
  // daily re-derive of the project labels into KV (server/worker.ts `scheduled`)
  "triggers": { "crons": ["17 9 * * *"] },
  "observability": { "enabled": true }
}
