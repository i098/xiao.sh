{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "strictNullChecks": true,
    "types": ["node", "react", "bun"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // web/main.ts imports the tui App tree, so it typechecks in the tui program (opentui JSX types)
  "exclude": ["node_modules", "tui", "server", "web/main.ts"]
}
