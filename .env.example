# Required for AI Search ("Ask AI" button).
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional.
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_SITE_NAME=xiao.sh

# Model rotation (recommended to reduce rate-limit failures).
# Comma-separated list to force/include specific models at the front of rotation.
# OPENROUTER_MODELS=openrouter/free
# Fetch latest free models from OpenRouter model catalog (set false to disable).
# OPENROUTER_DYNAMIC_MODELS=true
# How many free models to keep in rotation pool.
# OPENROUTER_MODEL_POOL_SIZE=8
# How often to refresh free model list from OpenRouter (milliseconds).
# OPENROUTER_MODELS_REFRESH_MS=900000

# Optional: LinkedIn auth for full profile scraping (About/Experience/Education/Skills/etc).
# Without this cookie LinkedIn serves an authwall and only public post metadata is available.
# LINKEDIN_COOKIE_LI_AT=your_linkedin_li_at_cookie
# Optional companion cookie if you have it:
# LINKEDIN_COOKIE_JSESSIONID=ajax:123456789
# Optional Playwright storage state path (session file), e.g. from joeyism/linkedin_scraper:
# LINKEDIN_STORAGE_STATE_PATH=/absolute/path/to/session.json

# Optional: PostHog product analytics (server-side, posthog-node) for the TUI.
# Grab the Project API key from PostHog -> Project settings. Host defaults to US cloud.
# POSTHOG_API_KEY=phc_your_project_key
# POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com

# Optional: Spotify now-playing widget (disc on home page).
# Create a Spotify app, authorize with scopes `user-read-currently-playing` and `user-read-playback-state`,
# and paste the resulting refresh token here.
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
